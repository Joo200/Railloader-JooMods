{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signals Everywhere Configuration Schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" }
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": {
      "anyOf": [ { "$ref": "#/definitions/SerializedCTCModule" }, { "type": "null" } ]
    }
  },
  "definitions": {
    "SerializedCTCModule": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "blocks": {
          "type": "object",
          "additionalProperties": { "anyOf": [ { "$ref": "#/definitions/SerializedCTCBlock" }, { "type": "null" } ] }
        },
        "autoSignals": {
          "type": "object",
          "additionalProperties": { "anyOf": [ { "$ref": "#/definitions/SerializedCTCAutoSignal" }, { "type": "null" } ] }
        },
        "predicateSignals": {
          "type": "object",
          "additionalProperties": { "anyOf": [ { "$ref": "#/definitions/SerializedCTCPredicateSignal" }, { "type": "null" } ] }
        },
        "interlocking": { "anyOf": [ { "$ref": "#/definitions/SerializedCTCInterlocking" }, { "type": "null" } ] },
        "intermediate": { "anyOf": [ { "$ref": "#/definitions/SerializedCTCIntermediate" }, { "type": "null" } ] },
        "crossover": { "anyOf": [ { "$ref": "#/definitions/SerializedCTCCrossover" }, { "type": "null" } ] }
      },
      "additionalProperties": false
    },
    "SerializedCTCBlock": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "spans": {
          "type": "array",
          "items": { "$ref": "#/definitions/SerializedSpan" }
        },
        "thrownSwitchesSetOccupied": { "type": "boolean", "default": true },
        "createInverse": { "type": "boolean", "default": false }
      },
      "required": [ "spans" ],
      "additionalProperties": false
    },
    "SerializedCTCAutoSignal": {
      "type": "object",
      "allOf": [ { "$ref": "#/definitions/SerializedCTCSignal" } ],
      "properties": {
        "id": true,
        "modelType": true,
        "headConfiguration": true,
        "direction": true,
        "location": true,
        "leftSide": true,
        "offset": true,
        "blocks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "interlockingRouteMapping": {
          "type": "array",
          "items": { "type": "integer" }
        }
      },
      "additionalProperties": false
    },
    "SerializedCTCPredicateSignal": {
      "type": "object",
      "allOf": [ { "$ref": "#/definitions/SerializedCTCSignal" } ],
      "properties": {
        "id": true,
        "modelType": true,
        "headConfiguration": true,
        "direction": true,
        "location": true,
        "leftSide": true,
        "offset": true,
        "heads": {
          "type": "array",
          "items": { "$ref": "#/definitions/HeadPredicates" }
        }
      },
      "additionalProperties": false
    },
    "SerializedCTCSignal": {
      "description": "Shared signal properties. Deliberately has no additionalProperties: false; each signal type re-lists these keys and closes itself, since draft-07 additionalProperties cannot see through allOf.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "modelType": { "type": "string", "default": "Vanilla" },
        "headConfiguration": { "$ref": "#/definitions/SignalHeadConfiguration" },
        "direction": { "$ref": "#/definitions/CTCDirection" },
        "location": { "$ref": "#/definitions/SerializedLocation" },
        "leftSide": { "type": "boolean", "default": false },
        "offset": { "type": "integer", "default": 3 }
      },
      "required": [ "headConfiguration", "direction", "location" ]
    },
    "SerializedCTCInterlocking": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "switchSets": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "outlets": {
          "type": "array",
          "items": { "$ref": "#/definitions/InterlockingOutlet" }
        },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/definitions/InterlockingRoute" }
        }
      },
      "required": [ "id", "displayName", "switchSets", "outlets", "routes" ],
      "additionalProperties": false
    },
    "SerializedCTCIntermediate": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "blocks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signalLeft": { "type": [ "string", "null" ] },
        "signalRight": { "type": [ "string", "null" ] }
      },
      "required": [ "id", "blocks", "signals" ],
      "additionalProperties": false
    },
    "SerializedCTCCrossover": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "switchSets": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "outlets": {
          "type": "array",
          "items": { "$ref": "#/definitions/CrossoverOutlet" }
        },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/definitions/CrossoverRoute" }
        },
        "signalGroups": {
          "type": "array",
          "items": { "$ref": "#/definitions/SignalGroup" }
        }
      },
      "required": [ "id", "displayName", "switchSets", "outlets", "routes", "signalGroups" ],
      "additionalProperties": false
    },
    "SerializedSpan": {
      "type": "object",
      "properties": {
        "lower": { "$ref": "#/definitions/SerializedLocation" },
        "upper": { "$ref": "#/definitions/SerializedLocation" },
        "normalize": { "type": "boolean", "default": false }
      },
      "required": [ "lower", "upper" ],
      "additionalProperties": false
    },
    "SerializedLocation": {
      "type": "object",
      "properties": {
        "segmentId": { "type": "string" },
        "distance": { "type": "number" },
        "end": { "type": "string", "enum": [ "Start", "End" ] }
      },
      "required": [ "segmentId", "distance", "end" ],
      "additionalProperties": false
    },
    "HeadPredicates": {
      "type": "object",
      "properties": {
        "predicates": {
          "type": "array",
          "items": { "$ref": "#/definitions/Predicate" }
        },
        "nextCtcSignal": { "type": [ "string", "null" ] }
      },
      "additionalProperties": false
    },
    "Predicate": {
      "type": "object",
      "properties": {
        "type": { "$ref": "#/definitions/PredicateType" },
        "switchNode": { "type": [ "string", "null" ] },
        "switchSetting": { "anyOf": [ { "$ref": "#/definitions/SwitchSetting" }, { "type": "null" } ] },
        "blocks": {
          "type": [ "array", "null" ],
          "items": { "type": "string" }
        },
        "interlocking": { "type": [ "string", "null" ] },
        "direction": { "anyOf": [ { "$ref": "#/definitions/SignalDirection" }, { "type": "null" } ] },
        "crossoverGroup": { "type": [ "string", "null" ] }
      },
      "additionalProperties": false
    },
    "InterlockingOutlet": {
      "type": "object",
      "properties": {
        "direction": { "$ref": "#/definitions/CTCDirection" },
        "blocks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nextSignal": { "type": [ "string", "null" ] }
      },
      "additionalProperties": false
    },
    "InterlockingRoute": {
      "type": "object",
      "properties": {
        "switchFilters": {
          "type": "array",
          "items": { "$ref": "#/definitions/SwitchSetting" }
        },
        "outletLeft": { "type": "integer" },
        "outletRight": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "CrossoverOutlet": {
      "type": "object",
      "properties": {
        "direction": { "$ref": "#/definitions/CTCDirection" },
        "blocks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nextSignal": { "type": [ "string", "null" ] }
      },
      "additionalProperties": false
    },
    "CrossoverRoute": {
      "type": "object",
      "properties": {
        "switchFilters": {
          "type": "array",
          "items": { "$ref": "#/definitions/SwitchSetting" }
        },
        "outletLeft": { "type": "integer" },
        "outletRight": { "type": "integer" },
        "usedBlocks": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "SignalGroup": {
      "type": "object",
      "properties": {
        "groupId": { "type": "string" },
        "signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowedDirection": { "$ref": "#/definitions/CTCDirection" },
        "allowedRoutes": {
          "type": "array",
          "items": { "type": "integer" }
        }
      },
      "additionalProperties": false
    },
    "SignalHeadConfiguration": {
      "type": "string",
      "enum": [ "Single", "Double", "Triple" ]
    },
    "CTCDirection": {
      "type": "string",
      "enum": [ "Left", "Right" ]
    },
    "SignalDirection": {
      "type": "string",
      "enum": [ "None", "Left", "Right" ]
    },
    "SwitchSetting": {
      "type": "string",
      "enum": [ "Normal", "Reversed", "None" ]
    },
    "PredicateType": {
      "type": "string",
      "enum": [ "Switch", "Block", "InterlockingTrafficDirection", "InterlockingTrafficDirectionIsNot", "AlwaysFalse" ]
    }
  }
}
